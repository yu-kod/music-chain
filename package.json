{
  "name": "music-chain",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:lambda": "cd backend && npm run build:lambda",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:lambda && npm run build:frontend",
    "deploy": "npm run build && cd infra && terraform apply",
    "deploy:sync": "aws s3 sync frontend/dist/ s3://music-chain-frontend-20260330161636932600000001 --delete",
    "deploy:invalidate": "aws cloudfront create-invalidation --distribution-id EHDXJUNB26EIE --paths /*",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "seed": "cd backend && npm run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
